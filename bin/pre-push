DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
DIR=${DIR##*/}
PATH="/usr/local/bin/:$PATH"

PATH="/usr/local/bin/:$PATH" && export PATH

returnValue=0

vendor/bin/mds-code-check
returnValue=$((returnValue + $?))

exit $returnValue
